// Code that runs in a worker scope: the service worker and the Cloudflare Pages middleware.
{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.worker.tsbuildinfo",
    "lib": ["ES2022", "WebWorker"],
    "types": []
  },
  "include": ["src/sw.ts", "functions"]
}
